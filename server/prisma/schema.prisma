// Client Project Management Platform — database schema (BRD section 5).
//
// Conventions (apply to every model unless noted):
// - id: native Postgres uuid, time-ordered UUIDv7 generated by Prisma.
// - workspace_id, created_at, created_by, updated_at, updated_by on every entity.
//   created_by / updated_by are plain uuids with no foreign key: the author may be
//   a User, a ClientContact or the system (null).
// - Field names are snake_case, matching the BRD and the API.
// - Money: BigInt in the currency's minor unit (JOD fils, USD/EUR cents). BR-INV-04.
//   Rates (cost/bill) are in the workspace currency unless a currency column says otherwise.
// - Durations: Int minutes (BR-TIME-05). Estimates/budgets are minutes too.
// - Percentages / tax rates: Int basis points (1600 = 16%).
// - Timestamps: timestamptz (UTC). Date-only fields: @db.Date in the workspace timezone (BR-PRJ-07).
// - version: optimistic-locking counter on editable records (NFR-CONC-01).
// - deleted_at: soft delete, restorable 30 days (BRD 5.2).
// - Constraints Prisma cannot express (CHECKs, triggers) live in the migration SQL.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (values mirror shared/src/constants.js)
// ---------------------------------------------------------------------------

enum Role {
  Owner
  Admin
  PM
  TeamMember
  Finance
}

enum UserStatus {
  Invited
  Active
  Deactivated
}

enum ContactStatus {
  NotInvited
  Invited
  Active
}

enum ClientStatus {
  Lead
  Active
  Inactive
  Archived
}

enum ProjectStatus {
  NotStarted
  InProgress
  OnHold
  Completed
  Cancelled
}

enum BillingType {
  Fixed
  Hourly
  Retainer
  NonBillable
}

enum ProjectRole {
  PM
  Member
}

enum PortalLevel {
  View
  Comment
  Approve
}

enum Visibility {
  Internal
  Client
}

enum MilestoneStatus {
  Upcoming
  InProgress
  Completed
  Overdue
}

enum TaskStatus {
  ToDo
  InProgress
  InReview
  Done
  Blocked
  Cancelled
}

enum TaskPriority {
  Low
  Normal
  High
  Urgent
}

enum DependencyType {
  FinishToStart
}

enum CommentEntityType {
  Project
  Task
  File
  Approval
}

enum ApprovalStatus {
  Pending
  Approved
  ChangesRequested
  Cancelled
  Superseded
}

enum ApprovalRule {
  Any
  All
}

enum ApprovalDecision {
  Approved
  ChangesRequested
}

enum TimeEntryStatus {
  Draft
  Submitted
  Approved
  Rejected
  Invoiced
}

enum TimesheetStatus {
  Draft
  Submitted
  Approved
  Rejected
}

enum ProposalStatus {
  Draft
  Sent
  Viewed
  Accepted
  Declined
  Expired
}

enum ContractStatus {
  Draft
  Sent
  SignedByAgency
  Signed
  Declined
}

enum SignerType {
  Agency
  Client
}

enum InvoiceStatus {
  Draft
  Sent
  PartiallyPaid
  Paid
  Overdue
  Void
}

enum InvoiceLineSource {
  Manual
  Time
  Milestone
  Expense
}

enum PaymentMethod {
  Card
  Bank
  Cash
  Other
}

enum PaymentStatus {
  Pending
  Succeeded
  Failed
  Refunded
}

enum NotificationChannel {
  InApp
  Email
}

enum ActorType {
  User
  Contact
  System
}

enum AuthTokenPurpose {
  Invite
  PasswordReset
  EmailChange
}

// ---------------------------------------------------------------------------
// Workspace, users
// ---------------------------------------------------------------------------

/// One agency account. The platform runs a single workspace for now, but every
/// table carries workspace_id so more can be added later.
model Workspace {
  id                    String    @id @default(uuid(7)) @db.Uuid
  name                  String    @db.VarChar(120)
  logo_key              String?   @db.VarChar(512)
  brand_color           String?   @db.VarChar(7)
  timezone              String    @default("UTC") @db.VarChar(64)
  currency              String    @default("JOD") @db.Char(3)
  date_format           String    @default("DD/MM/YYYY") @db.VarChar(20)
  /// 0 = Sunday … 6 = Saturday (FR-WS-01, BR-DASH-02)
  week_start_day        Int       @default(0) @db.SmallInt
  invoice_prefix        String    @default("INV-") @db.VarChar(20)
  next_invoice_number   Int       @default(1)
  proposal_prefix       String    @default("PRO-") @db.VarChar(20)
  next_proposal_number  Int       @default(1)
  /// Owner-requested deletion; hard delete after the 30-day grace (BRD 5.2)
  deletion_scheduled_at DateTime? @db.Timestamptz(3)
  created_at            DateTime  @default(now()) @db.Timestamptz(3)
  created_by            String?   @db.Uuid
  updated_at            DateTime  @updatedAt @db.Timestamptz(3)
  updated_by            String?   @db.Uuid
  version               Int       @default(1)

  users                User[]
  clients              Client[]
  client_contacts      ClientContact[]
  projects             Project[]
  project_members      ProjectMember[]
  milestones           Milestone[]
  tasks                Task[]
  task_assignees       TaskAssignee[]
  task_dependencies    TaskDependency[]
  comments             Comment[]
  mentions             Mention[]
  followers            Follower[]
  files                File[]
  file_versions        FileVersion[]
  approval_requests    ApprovalRequest[]
  approval_approvers   ApprovalApprover[]
  time_entries         TimeEntry[]
  timesheets           Timesheet[]
  proposals            Proposal[]
  proposal_lines       ProposalLine[]
  contracts            Contract[]
  contract_signatures  ContractSignature[]
  invoices             Invoice[]
  invoice_lines        InvoiceLine[]
  payments             Payment[]
  expenses             Expense[]
  notifications        Notification[]
  activity_logs        ActivityLog[]
  sessions             Session[]
  auth_tokens          AuthToken[]
  login_throttles      LoginThrottle[]
  task_checklist_items TaskChecklistItem[]
  project_templates    ProjectTemplate[]

  @@map("workspaces")
}

/// Internal staff. Never hard-deleted (BR-USER-01).
model User {
  id                        String     @id @default(uuid(7)) @db.Uuid
  workspace_id              String     @db.Uuid
  /// Lowercased + trimmed (BR-AUTH-04). Unique across the whole platform and
  /// across client_contacts (login identity; enforced by trigger).
  email                     String     @unique @db.VarChar(254)
  full_name                 String     @db.VarChar(120)
  role                      Role
  status                    UserStatus @default(Invited)
  password_hash             String?    @db.VarChar(255)
  phone                     String?    @db.VarChar(40)
  avatar_key                String?    @db.VarChar(512)
  /// Personal display timezone; null = workspace timezone (NFR-TZ-01)
  timezone                  String?    @db.VarChar(64)
  hourly_cost_rate          BigInt?
  default_bill_rate         BigInt?
  /// FR-USER-09: default 40 h/week
  capacity_minutes_per_week Int        @default(2400)
  last_login_at             DateTime?  @db.Timestamptz(3)
  deactivated_at            DateTime?  @db.Timestamptz(3)
  created_at                DateTime   @default(now()) @db.Timestamptz(3)
  created_by                String?    @db.Uuid
  updated_at                DateTime   @updatedAt @db.Timestamptz(3)
  updated_by                String?    @db.Uuid
  version                   Int        @default(1)

  workspace           Workspace           @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  pm_of_projects      Project[]           @relation("ProjectPM")
  project_memberships ProjectMember[]
  task_assignments    TaskAssignee[]
  comments            Comment[]
  mentions            Mention[]
  follows             Follower[]
  uploaded_versions   FileVersion[]
  approval_requests   ApprovalRequest[]
  time_entries        TimeEntry[]
  timesheets          Timesheet[]         @relation("TimesheetOwner")
  approved_timesheets Timesheet[]         @relation("TimesheetApprover")
  contract_signatures ContractSignature[]
  notifications       Notification[]
  sessions            Session[]
  auth_tokens         AuthToken[]

  @@index([workspace_id, role, status])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Clients and contacts
// ---------------------------------------------------------------------------

model Client {
  id                    String       @id @default(uuid(7)) @db.Uuid
  workspace_id          String       @db.Uuid
  name                  String       @db.VarChar(120)
  /// lower(trim(name)) — FR-CLI-01 case-insensitive uniqueness
  name_normalized       String       @db.VarChar(120)
  /// 3 uppercase letters used in project codes, e.g. NOV → NOV-001 (FR-PRJ-01).
  /// If taken, another unique prefix is suggested (e.g. NVR). Editable by Admin/PM
  /// only until the client's first project exists, then locked (DECISIONS.md D-02).
  code_prefix           String       @db.Char(3)
  /// Per-client counter for project codes
  next_project_number   Int          @default(1)
  /// D-02: set when the first project is created; the prefix cannot change after
  code_prefix_locked_at DateTime?    @db.Timestamptz(3)
  status                ClientStatus @default(Active)
  industry              String?      @db.VarChar(120)
  website               String?      @db.VarChar(2048)
  billing_address       String?
  tax_id                String?      @db.VarChar(64)
  currency              String       @db.Char(3)
  default_bill_rate     BigInt?
  payment_terms_days    Int          @default(30)
  /// FR-CLI-08: internal roles only, never returned by portal APIs
  internal_notes        String?
  archived_at           DateTime?    @db.Timestamptz(3)
  created_at            DateTime     @default(now()) @db.Timestamptz(3)
  created_by            String?      @db.Uuid
  updated_at            DateTime     @updatedAt @db.Timestamptz(3)
  updated_by            String?      @db.Uuid
  version               Int          @default(1)

  workspace Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  contacts  ClientContact[]
  projects  Project[]
  proposals Proposal[]
  contracts Contract[]
  invoices  Invoice[]

  @@unique([workspace_id, name_normalized])
  @@unique([workspace_id, code_prefix])
  @@index([workspace_id, status])
  @@map("clients")
}

/// A person at a client company; may log into the portal (BRD 4.1).
model ClientContact {
  id                   String        @id @default(uuid(7)) @db.Uuid
  workspace_id         String        @db.Uuid
  /// BR-ROLE-06: a contact belongs to exactly one client, never moved
  client_id            String        @db.Uuid
  full_name            String        @db.VarChar(120)
  /// Lowercased + trimmed; unique platform-wide and vs users (trigger)
  email                String        @unique @db.VarChar(254)
  phone                String?       @db.VarChar(40)
  job_title            String?       @db.VarChar(120)
  portal_access        Boolean       @default(false)
  status               ContactStatus @default(NotInvited)
  is_primary           Boolean       @default(false)
  /// D-16: may accept proposals, sign contracts and pay invoices for the client.
  /// The primary contact gets it by default; Owner/Admin/PM can change it.
  commercial_authority Boolean       @default(false)
  password_hash        String?       @db.VarChar(255)
  /// Personal display timezone; null = workspace timezone (FR-AUTH-13)
  timezone             String?       @db.VarChar(64)
  last_login_at        DateTime?     @db.Timestamptz(3)
  created_at           DateTime      @default(now()) @db.Timestamptz(3)
  created_by           String?       @db.Uuid
  updated_at           DateTime      @updatedAt @db.Timestamptz(3)
  updated_by           String?       @db.Uuid
  version              Int           @default(1)

  workspace           Workspace           @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  client              Client              @relation(fields: [client_id], references: [id], onDelete: Restrict)
  project_memberships ProjectMember[]
  requested_tasks     Task[]
  comments            Comment[]
  mentions            Mention[]
  follows             Follower[]
  uploaded_versions   FileVersion[]
  approvals           ApprovalApprover[]
  accepted_proposals  Proposal[]
  contract_signatures ContractSignature[]
  notifications       Notification[]
  sessions            Session[]
  auth_tokens         AuthToken[]

  /// FR-CON-02: at most one primary contact per client
  @@unique([client_id], map: "client_contacts_one_primary_per_client", where: raw("is_primary"))
  @@index([workspace_id, client_id])
  @@map("client_contacts")
}

// ---------------------------------------------------------------------------
// Projects, members, milestones
// ---------------------------------------------------------------------------

model Project {
  id                     String        @id @default(uuid(7)) @db.Uuid
  workspace_id           String        @db.Uuid
  client_id              String        @db.Uuid
  name                   String        @db.VarChar(150)
  /// lower(trim(name)) — BR-PRJ-01 unique per client
  name_normalized        String        @db.VarChar(150)
  description            String?
  /// <CLIENT3>-<NNN>, e.g. NOV-001; never reused
  code                   String        @db.VarChar(20)
  status                 ProjectStatus @default(NotStarted)
  start_date             DateTime      @db.Date
  due_date               DateTime?     @db.Date
  billing_type           BillingType
  /// Minor units of the client currency
  budget_amount          BigInt?
  budget_minutes         Int?
  /// FR-PRJ-07: calculated, 0–100
  progress_pct           Int           @default(0) @db.SmallInt
  pm_user_id             String        @db.Uuid
  portal_enabled         Boolean       @default(false)
  /// BR-APP-03
  close_task_on_approval Boolean       @default(false)
  /// FR-PRJ-02 / FR-PRJ-12: where the structure came from
  source_template_id     String?       @db.Uuid
  duplicated_from_id     String?       @db.Uuid
  completed_at           DateTime?     @db.Timestamptz(3)
  /// Archived is a flag on Completed/Cancelled projects, not a status (BRD 16.1)
  archived_at            DateTime?     @db.Timestamptz(3)
  archived_by            String?       @db.Uuid
  deleted_at             DateTime?     @db.Timestamptz(3)
  deleted_by             String?       @db.Uuid
  created_at             DateTime      @default(now()) @db.Timestamptz(3)
  created_by             String?       @db.Uuid
  updated_at             DateTime      @updatedAt @db.Timestamptz(3)
  updated_by             String?       @db.Uuid
  version                Int           @default(1)

  workspace         Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  client            Client            @relation(fields: [client_id], references: [id], onDelete: Restrict)
  pm_user           User              @relation("ProjectPM", fields: [pm_user_id], references: [id], onDelete: Restrict)
  members           ProjectMember[]
  milestones        Milestone[]
  tasks             Task[]
  comments          Comment[]
  files             File[]
  approval_requests ApprovalRequest[]
  time_entries      TimeEntry[]
  proposal          Proposal?
  contracts         Contract[]
  invoices          Invoice[]
  expenses          Expense[]
  source_template   ProjectTemplate?  @relation(fields: [source_template_id], references: [id], onDelete: SetNull)

  @@unique([workspace_id, code])
  @@unique([client_id, name_normalized], map: "projects_name_unique_per_client", where: raw("deleted_at IS NULL"))
  @@index([workspace_id, status])
  @@index([pm_user_id])
  @@map("projects")
}

/// A user (project_role) or a contact (portal_level) on a project. Exactly one of
/// user_id / contact_id is set (CHECK in migration).
model ProjectMember {
  id                 String       @id @default(uuid(7)) @db.Uuid
  workspace_id       String       @db.Uuid
  project_id         String       @db.Uuid
  user_id            String?      @db.Uuid
  contact_id         String?      @db.Uuid
  project_role       ProjectRole?
  portal_level       PortalLevel?
  /// Minor units of the CLIENT currency. Required for billable time when the client
  /// currency differs from the workspace currency (DECISIONS.md D-04).
  bill_rate_override BigInt?
  created_at         DateTime     @default(now()) @db.Timestamptz(3)
  created_by         String?      @db.Uuid
  updated_at         DateTime     @updatedAt @db.Timestamptz(3)
  updated_by         String?      @db.Uuid
  version            Int          @default(1)

  workspace Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  project   Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [user_id], references: [id], onDelete: Restrict)
  contact   ClientContact? @relation(fields: [contact_id], references: [id], onDelete: Restrict)

  @@unique([project_id, user_id])
  @@unique([project_id, contact_id])
  @@index([user_id])
  @@index([contact_id])
  @@map("project_members")
}

model Milestone {
  id              String          @id @default(uuid(7)) @db.Uuid
  workspace_id    String          @db.Uuid
  project_id      String          @db.Uuid
  title           String          @db.VarChar(255)
  description     String?
  due_date        DateTime        @db.Date
  status          MilestoneStatus @default(Upcoming)
  /// FR-MS-04: milestone billing, minor units of the client currency
  amount          BigInt?
  visibility      Visibility      @default(Internal)
  sort_order      Int             @default(0)
  completed_at    DateTime?       @db.Timestamptz(3)
  /// BR-INV-05: on at most one non-void invoice
  invoice_line_id String?         @db.Uuid
  deleted_at      DateTime?       @db.Timestamptz(3)
  created_at      DateTime        @default(now()) @db.Timestamptz(3)
  created_by      String?         @db.Uuid
  updated_at      DateTime        @updatedAt @db.Timestamptz(3)
  updated_by      String?         @db.Uuid
  version         Int             @default(1)

  workspace    Workspace    @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  project      Project      @relation(fields: [project_id], references: [id], onDelete: Restrict)
  invoice_line InvoiceLine? @relation(fields: [invoice_line_id], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@index([project_id, sort_order])
  @@map("milestones")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id                      String       @id @default(uuid(7)) @db.Uuid
  workspace_id            String       @db.Uuid
  project_id              String       @db.Uuid
  milestone_id            String?      @db.Uuid
  /// Subtask parent; max nesting depth 2 (FR-TSK-04, enforced in service)
  parent_task_id          String?      @db.Uuid
  title                   String       @db.VarChar(255)
  /// Sanitised rich text
  description             String?
  status                  TaskStatus   @default(ToDo)
  priority                TaskPriority @default(Normal)
  start_date              DateTime?    @db.Date
  due_date                DateTime?    @db.Date
  /// Hours in 0.25 steps, stored as minutes (multiples of 15)
  estimate_minutes        Int?
  visibility              Visibility   @default(Internal)
  /// null = inherit from project (FR-TIME-02)
  is_billable             Boolean?
  sort_order              Int          @default(0)
  /// FR-TSK-02 labels (max 10, each ≤ 30 chars); "Client request" marks portal requests
  labels                  String[]     @default([])
  /// FR-PORT-03: created from a portal request
  is_client_request       Boolean      @default(false)
  requested_by_contact_id String?      @db.Uuid
  completed_at            DateTime?    @db.Timestamptz(3)
  deleted_at              DateTime?    @db.Timestamptz(3)
  created_at              DateTime     @default(now()) @db.Timestamptz(3)
  created_by              String?      @db.Uuid
  updated_at              DateTime     @updatedAt @db.Timestamptz(3)
  updated_by              String?      @db.Uuid
  version                 Int          @default(1)

  workspace         Workspace           @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  project           Project             @relation(fields: [project_id], references: [id], onDelete: Restrict)
  milestone         Milestone?          @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  parent            Task?               @relation("Subtasks", fields: [parent_task_id], references: [id], onDelete: Restrict)
  subtasks          Task[]              @relation("Subtasks")
  requested_by      ClientContact?      @relation(fields: [requested_by_contact_id], references: [id], onDelete: Restrict)
  assignees         TaskAssignee[]
  predecessors      TaskDependency[]    @relation("DependencySuccessor")
  successors        TaskDependency[]    @relation("DependencyPredecessor")
  files             File[]
  approval_requests ApprovalRequest[]
  time_entries      TimeEntry[]
  checklist_items   TaskChecklistItem[]

  @@index([project_id, status])
  @@index([project_id, sort_order])
  @@index([milestone_id])
  @@index([parent_task_id])
  @@index([labels], map: "tasks_labels_gin", type: Gin)
  @@map("tasks")
}

model TaskAssignee {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspace_id String   @db.Uuid
  task_id      String   @db.Uuid
  user_id      String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  created_by   String?  @db.Uuid
  updated_at   DateTime @updatedAt @db.Timestamptz(3)
  updated_by   String?  @db.Uuid

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  task      Task      @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@unique([task_id, user_id])
  @@index([user_id])
  @@map("task_assignees")
}

/// Finish-to-Start; no cycles (FR-TSK-07, checked in service).
model TaskDependency {
  id             String         @id @default(uuid(7)) @db.Uuid
  workspace_id   String         @db.Uuid
  predecessor_id String         @db.Uuid
  successor_id   String         @db.Uuid
  type           DependencyType @default(FinishToStart)
  created_at     DateTime       @default(now()) @db.Timestamptz(3)
  created_by     String?        @db.Uuid
  updated_at     DateTime       @updatedAt @db.Timestamptz(3)
  updated_by     String?        @db.Uuid

  workspace   Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  predecessor Task      @relation("DependencyPredecessor", fields: [predecessor_id], references: [id], onDelete: Cascade)
  successor   Task      @relation("DependencySuccessor", fields: [successor_id], references: [id], onDelete: Cascade)

  @@unique([predecessor_id, successor_id])
  @@index([successor_id])
  @@map("task_dependencies")
}

// ---------------------------------------------------------------------------
// Comments, mentions, followers
// ---------------------------------------------------------------------------

/// Attached to a project, task, file or approval (entity_type + entity_id, no FK).
/// project_id is always set so portal and permission checks can scope by project.
/// Exactly one author column is set (CHECK in migration).
model Comment {
  id                String            @id @default(uuid(7)) @db.Uuid
  workspace_id      String            @db.Uuid
  project_id        String            @db.Uuid
  entity_type       CommentEntityType
  entity_id         String            @db.Uuid
  author_user_id    String?           @db.Uuid
  author_contact_id String?           @db.Uuid
  body              String
  visibility        Visibility        @default(Internal)
  edited_at         DateTime?         @db.Timestamptz(3)
  deleted_at        DateTime?         @db.Timestamptz(3)
  created_at        DateTime          @default(now()) @db.Timestamptz(3)
  created_by        String?           @db.Uuid
  updated_at        DateTime          @updatedAt @db.Timestamptz(3)
  updated_by        String?           @db.Uuid
  version           Int               @default(1)

  workspace      Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  project        Project        @relation(fields: [project_id], references: [id], onDelete: Restrict)
  author_user    User?          @relation(fields: [author_user_id], references: [id], onDelete: Restrict)
  author_contact ClientContact? @relation(fields: [author_contact_id], references: [id], onDelete: Restrict)
  mentions       Mention[]

  @@index([entity_type, entity_id, created_at])
  @@index([project_id])
  @@map("comments")
}

model Mention {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspace_id String   @db.Uuid
  comment_id   String   @db.Uuid
  user_id      String?  @db.Uuid
  contact_id   String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  created_by   String?  @db.Uuid
  updated_at   DateTime @updatedAt @db.Timestamptz(3)
  updated_by   String?  @db.Uuid

  workspace Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  comment   Comment        @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [user_id], references: [id], onDelete: Restrict)
  contact   ClientContact? @relation(fields: [contact_id], references: [id], onDelete: Restrict)

  @@unique([comment_id, user_id])
  @@unique([comment_id, contact_id])
  @@map("mentions")
}

/// FR-NOT-05: who follows which record (entity_type is free text, e.g. "Task").
model Follower {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspace_id String   @db.Uuid
  entity_type  String   @db.VarChar(40)
  entity_id    String   @db.Uuid
  user_id      String?  @db.Uuid
  contact_id   String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  created_by   String?  @db.Uuid
  updated_at   DateTime @updatedAt @db.Timestamptz(3)
  updated_by   String?  @db.Uuid

  workspace Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  user      User?          @relation(fields: [user_id], references: [id], onDelete: Restrict)
  contact   ClientContact? @relation(fields: [contact_id], references: [id], onDelete: Restrict)

  @@unique([entity_type, entity_id, user_id])
  @@unique([entity_type, entity_id, contact_id])
  @@map("followers")
}

// ---------------------------------------------------------------------------
// Files and approvals
// ---------------------------------------------------------------------------

model File {
  id           String     @id @default(uuid(7)) @db.Uuid
  workspace_id String     @db.Uuid
  project_id   String     @db.Uuid
  task_id      String?    @db.Uuid
  name         String     @db.VarChar(255)
  visibility   Visibility @default(Internal)
  deleted_at   DateTime?  @db.Timestamptz(3)
  created_at   DateTime   @default(now()) @db.Timestamptz(3)
  created_by   String?    @db.Uuid
  updated_at   DateTime   @updatedAt @db.Timestamptz(3)
  updated_by   String?    @db.Uuid
  version      Int        @default(1)

  workspace Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  project   Project       @relation(fields: [project_id], references: [id], onDelete: Restrict)
  task      Task?         @relation(fields: [task_id], references: [id], onDelete: SetNull)
  versions  FileVersion[]
  expenses  Expense[]

  @@index([project_id])
  @@index([task_id])
  @@map("files")
}

/// One uploaded binary. Exactly one uploader column is set (CHECK in migration).
model FileVersion {
  id                     String    @id @default(uuid(7)) @db.Uuid
  workspace_id           String    @db.Uuid
  file_id                String    @db.Uuid
  version_no             Int
  mime_type              String    @db.VarChar(255)
  size_bytes             BigInt
  storage_key            String    @unique @db.VarChar(512)
  uploaded_by_user_id    String?   @db.Uuid
  uploaded_by_contact_id String?   @db.Uuid
  deleted_at             DateTime? @db.Timestamptz(3)
  created_at             DateTime  @default(now()) @db.Timestamptz(3)
  created_by             String?   @db.Uuid
  updated_at             DateTime  @updatedAt @db.Timestamptz(3)
  updated_by             String?   @db.Uuid

  workspace           Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  file                File              @relation(fields: [file_id], references: [id], onDelete: Restrict)
  uploaded_by_user    User?             @relation(fields: [uploaded_by_user_id], references: [id], onDelete: Restrict)
  uploaded_by_contact ClientContact?    @relation(fields: [uploaded_by_contact_id], references: [id], onDelete: Restrict)
  approval_requests   ApprovalRequest[]

  @@unique([file_id, version_no])
  @@map("file_versions")
}

/// One approval round on a file version or a task (FR-APP-01). Exactly one of
/// file_version_id / task_id is set (CHECK in migration).
model ApprovalRequest {
  id              String         @id @default(uuid(7)) @db.Uuid
  workspace_id    String         @db.Uuid
  project_id      String         @db.Uuid
  file_version_id String?        @db.Uuid
  task_id         String?        @db.Uuid
  requested_by    String         @db.Uuid
  rule            ApprovalRule   @default(Any)
  message         String?
  due_date        DateTime?      @db.Date
  status          ApprovalStatus @default(Pending)
  /// Contact whose decision closed the round
  decision_by     String?        @db.Uuid
  decision_at     DateTime?      @db.Timestamptz(3)
  decision_note   String?
  created_at      DateTime       @default(now()) @db.Timestamptz(3)
  created_by      String?        @db.Uuid
  updated_at      DateTime       @updatedAt @db.Timestamptz(3)
  updated_by      String?        @db.Uuid
  version         Int            @default(1)

  workspace    Workspace          @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  project      Project            @relation(fields: [project_id], references: [id], onDelete: Restrict)
  file_version FileVersion?       @relation(fields: [file_version_id], references: [id], onDelete: Restrict)
  task         Task?              @relation(fields: [task_id], references: [id], onDelete: Restrict)
  requester    User               @relation(fields: [requested_by], references: [id], onDelete: Restrict)
  approvers    ApprovalApprover[]

  @@index([project_id, status])
  @@index([file_version_id])
  @@map("approval_requests")
}

/// One approver on a round and their own decision (FR-APP-03/04: name, time, IP).
model ApprovalApprover {
  id                  String            @id @default(uuid(7)) @db.Uuid
  workspace_id        String            @db.Uuid
  approval_request_id String            @db.Uuid
  contact_id          String            @db.Uuid
  decision            ApprovalDecision?
  decision_note       String?
  decided_at          DateTime?         @db.Timestamptz(3)
  decision_ip         String?           @db.VarChar(45)
  created_at          DateTime          @default(now()) @db.Timestamptz(3)
  created_by          String?           @db.Uuid
  updated_at          DateTime          @updatedAt @db.Timestamptz(3)
  updated_by          String?           @db.Uuid

  workspace        Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  approval_request ApprovalRequest @relation(fields: [approval_request_id], references: [id], onDelete: Cascade)
  contact          ClientContact   @relation(fields: [contact_id], references: [id], onDelete: Restrict)

  @@unique([approval_request_id, contact_id])
  @@map("approval_approvers")
}

// ---------------------------------------------------------------------------
// Time
// ---------------------------------------------------------------------------

model TimeEntry {
  id                String          @id @default(uuid(7)) @db.Uuid
  workspace_id      String          @db.Uuid
  user_id           String          @db.Uuid
  project_id        String          @db.Uuid
  task_id           String?         @db.Uuid
  timesheet_id      String?         @db.Uuid
  date              DateTime        @db.Date
  /// BR-TIME-01: 1..1440 (CHECK in migration)
  duration_minutes  Int
  note              String?
  is_billable       Boolean
  /// Snapshots taken on approval (FR-TIME-06), workspace currency minor units
  bill_rate         BigInt?
  cost_rate         BigInt?
  status            TimeEntryStatus @default(Draft)
  rejection_reason  String?
  /// FR-TIME-08
  entered_on_behalf Boolean         @default(false)
  invoice_line_id   String?         @db.Uuid
  created_at        DateTime        @default(now()) @db.Timestamptz(3)
  created_by        String?         @db.Uuid
  updated_at        DateTime        @updatedAt @db.Timestamptz(3)
  updated_by        String?         @db.Uuid
  version           Int             @default(1)

  workspace    Workspace    @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Restrict)
  project      Project      @relation(fields: [project_id], references: [id], onDelete: Restrict)
  task         Task?        @relation(fields: [task_id], references: [id], onDelete: Restrict)
  timesheet    Timesheet?   @relation(fields: [timesheet_id], references: [id], onDelete: SetNull)
  invoice_line InvoiceLine? @relation(fields: [invoice_line_id], references: [id], onDelete: SetNull)

  @@index([user_id, date])
  @@index([project_id, status])
  @@index([task_id])
  @@map("time_entries")
}

/// One per user per week (BRD 5.1).
model Timesheet {
  id               String          @id @default(uuid(7)) @db.Uuid
  workspace_id     String          @db.Uuid
  user_id          String          @db.Uuid
  week_start       DateTime        @db.Date
  status           TimesheetStatus @default(Draft)
  submitted_at     DateTime?       @db.Timestamptz(3)
  approved_by      String?         @db.Uuid
  approved_at      DateTime?       @db.Timestamptz(3)
  rejection_reason String?
  created_at       DateTime        @default(now()) @db.Timestamptz(3)
  created_by       String?         @db.Uuid
  updated_at       DateTime        @updatedAt @db.Timestamptz(3)
  updated_by       String?         @db.Uuid
  version          Int             @default(1)

  workspace Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  user      User        @relation("TimesheetOwner", fields: [user_id], references: [id], onDelete: Restrict)
  approver  User?       @relation("TimesheetApprover", fields: [approved_by], references: [id], onDelete: Restrict)
  entries   TimeEntry[]

  @@unique([user_id, week_start])
  @@map("timesheets")
}

// ---------------------------------------------------------------------------
// Proposals and contracts
// ---------------------------------------------------------------------------

model Proposal {
  id                     String         @id @default(uuid(7)) @db.Uuid
  workspace_id           String         @db.Uuid
  client_id              String         @db.Uuid
  title                  String         @db.VarChar(255)
  /// Assigned on send
  number                 String?        @db.VarChar(40)
  intro                  String?
  currency               String         @db.Char(3)
  subtotal               BigInt         @default(0)
  tax_total              BigInt         @default(0)
  total                  BigInt         @default(0)
  valid_until            DateTime?      @db.Date
  status                 ProposalStatus @default(Draft)
  sent_at                DateTime?      @db.Timestamptz(3)
  viewed_at              DateTime?      @db.Timestamptz(3)
  accepted_by_contact_id String?        @db.Uuid
  /// FR-PROP-04: typed name
  accepted_name          String?        @db.VarChar(120)
  accepted_at            DateTime?      @db.Timestamptz(3)
  declined_reason        String?
  /// Set on acceptance (FR-PROP-05); one project per proposal
  project_id             String?        @unique @db.Uuid
  /// BR-PROP-01: revisions
  revision_no            Int            @default(1)
  revised_from_id        String?        @db.Uuid
  /// Hash of the tokenised public link (FR-PROP-02); the raw token is never stored
  public_token_hash      String?        @unique @db.VarChar(128)
  created_at             DateTime       @default(now()) @db.Timestamptz(3)
  created_by             String?        @db.Uuid
  updated_at             DateTime       @updatedAt @db.Timestamptz(3)
  updated_by             String?        @db.Uuid
  version                Int            @default(1)

  workspace    Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  client       Client         @relation(fields: [client_id], references: [id], onDelete: Restrict)
  accepted_by  ClientContact? @relation(fields: [accepted_by_contact_id], references: [id], onDelete: Restrict)
  project      Project?       @relation(fields: [project_id], references: [id], onDelete: Restrict)
  revised_from Proposal?      @relation("ProposalRevision", fields: [revised_from_id], references: [id], onDelete: Restrict)
  revisions    Proposal[]     @relation("ProposalRevision")
  lines        ProposalLine[]
  contracts    Contract[]

  @@unique([workspace_id, number])
  @@index([client_id, status])
  @@map("proposals")
}

model ProposalLine {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspace_id String   @db.Uuid
  proposal_id  String   @db.Uuid
  description  String
  quantity     Decimal  @db.Decimal(12, 3)
  /// Ten-thousandths of the currency unit (4 decimals, any currency). Line totals are
  /// rounded half-up to the currency decimals, then summed (DECISIONS.md D-03).
  unit_price   BigInt
  tax_rate_bp  Int      @default(0)
  line_total   BigInt
  /// Optional package grouping (FR-PROP-01)
  package_name String?  @db.VarChar(120)
  is_optional  Boolean  @default(false)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  created_by   String?  @db.Uuid
  updated_at   DateTime @updatedAt @db.Timestamptz(3)
  updated_by   String?  @db.Uuid

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  proposal  Proposal  @relation(fields: [proposal_id], references: [id], onDelete: Cascade)

  @@index([proposal_id, sort_order])
  @@map("proposal_lines")
}

model Contract {
  id               String         @id @default(uuid(7)) @db.Uuid
  workspace_id     String         @db.Uuid
  client_id        String         @db.Uuid
  proposal_id      String?        @db.Uuid
  project_id       String?        @db.Uuid
  title            String         @db.VarChar(255)
  body             String
  /// FR-CTR-03, basis points
  deposit_pct_bp   Int?
  status           ContractStatus @default(Draft)
  sent_at          DateTime?      @db.Timestamptz(3)
  /// FR-CTR-02: locked final PDF
  final_pdf_key    String?        @db.VarChar(512)
  final_pdf_sha256 String?        @db.Char(64)
  created_at       DateTime       @default(now()) @db.Timestamptz(3)
  created_by       String?        @db.Uuid
  updated_at       DateTime       @updatedAt @db.Timestamptz(3)
  updated_by       String?        @db.Uuid
  version          Int            @default(1)

  workspace  Workspace           @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  client     Client              @relation(fields: [client_id], references: [id], onDelete: Restrict)
  proposal   Proposal?           @relation(fields: [proposal_id], references: [id], onDelete: Restrict)
  project    Project?            @relation(fields: [project_id], references: [id], onDelete: Restrict)
  signatures ContractSignature[]

  @@index([client_id, status])
  @@map("contracts")
}

/// FR-CTR-02: name, email, timestamp, IP per signature.
model ContractSignature {
  id                String     @id @default(uuid(7)) @db.Uuid
  workspace_id      String     @db.Uuid
  contract_id       String     @db.Uuid
  signer_type       SignerType
  signer_user_id    String?    @db.Uuid
  signer_contact_id String?    @db.Uuid
  signer_name       String     @db.VarChar(120)
  signer_email      String     @db.VarChar(254)
  signed_at         DateTime   @db.Timestamptz(3)
  ip                String     @db.VarChar(45)
  user_agent        String?    @db.VarChar(512)
  created_at        DateTime   @default(now()) @db.Timestamptz(3)
  created_by        String?    @db.Uuid
  updated_at        DateTime   @updatedAt @db.Timestamptz(3)
  updated_by        String?    @db.Uuid

  workspace Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  contract  Contract       @relation(fields: [contract_id], references: [id], onDelete: Restrict)
  user      User?          @relation(fields: [signer_user_id], references: [id], onDelete: Restrict)
  contact   ClientContact? @relation(fields: [signer_contact_id], references: [id], onDelete: Restrict)

  @@unique([contract_id, signer_type])
  @@map("contract_signatures")
}

// ---------------------------------------------------------------------------
// Invoices, payments, expenses
// ---------------------------------------------------------------------------

model Invoice {
  id                 String        @id @default(uuid(7)) @db.Uuid
  workspace_id       String        @db.Uuid
  client_id          String        @db.Uuid
  project_id         String?       @db.Uuid
  /// Assigned atomically on send (BR-INV-01); never reused
  number             String?       @db.VarChar(40)
  issue_date         DateTime      @db.Date
  due_date           DateTime      @db.Date
  /// BR-INV-04: = client currency
  currency           String        @db.Char(3)
  subtotal           BigInt        @default(0)
  discount_amount    BigInt        @default(0)
  tax_total          BigInt        @default(0)
  total              BigInt        @default(0)
  amount_paid        BigInt        @default(0)
  balance            BigInt        @default(0)
  status             InvoiceStatus @default(Draft)
  sent_at            DateTime?     @db.Timestamptz(3)
  voided_at          DateTime?     @db.Timestamptz(3)
  /// FR-INV-08: credit note points at the invoice it corrects
  credit_note_for_id String?       @db.Uuid
  public_token_hash  String?       @unique @db.VarChar(128)
  created_at         DateTime      @default(now()) @db.Timestamptz(3)
  created_by         String?       @db.Uuid
  updated_at         DateTime      @updatedAt @db.Timestamptz(3)
  updated_by         String?       @db.Uuid
  version            Int           @default(1)

  workspace       Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  client          Client        @relation(fields: [client_id], references: [id], onDelete: Restrict)
  project         Project?      @relation(fields: [project_id], references: [id], onDelete: Restrict)
  credit_note_for Invoice?      @relation("CreditNotes", fields: [credit_note_for_id], references: [id], onDelete: Restrict)
  credit_notes    Invoice[]     @relation("CreditNotes")
  lines           InvoiceLine[]
  payments        Payment[]

  @@unique([workspace_id, number])
  @@index([client_id, status])
  @@index([status, due_date])
  @@map("invoices")
}

/// Billed items link back here via time_entries / milestones / expenses.invoice_line_id.
model InvoiceLine {
  id            String            @id @default(uuid(7)) @db.Uuid
  workspace_id  String            @db.Uuid
  invoice_id    String            @db.Uuid
  description   String
  quantity      Decimal           @db.Decimal(12, 3)
  /// Ten-thousandths of the currency unit (4 decimals, any currency). Line totals are
  /// rounded half-up to the currency decimals, then summed (DECISIONS.md D-03).
  unit_price    BigInt
  tax_rate_bp   Int               @default(0)
  line_subtotal BigInt
  line_tax      BigInt
  line_total    BigInt
  source_type   InvoiceLineSource @default(Manual)
  sort_order    Int               @default(0)
  created_at    DateTime          @default(now()) @db.Timestamptz(3)
  created_by    String?           @db.Uuid
  updated_at    DateTime          @updatedAt @db.Timestamptz(3)
  updated_by    String?           @db.Uuid

  workspace    Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  invoice      Invoice     @relation(fields: [invoice_id], references: [id], onDelete: Restrict)
  time_entries TimeEntry[]
  milestones   Milestone[]
  expenses     Expense[]

  @@index([invoice_id, sort_order])
  @@map("invoice_lines")
}

model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  workspace_id   String        @db.Uuid
  invoice_id     String        @db.Uuid
  /// BR-INV-03: > 0 (CHECK in migration), ≤ balance (service)
  amount         BigInt
  date           DateTime      @db.Date
  method         PaymentMethod
  reference      String?       @db.VarChar(120)
  /// BR-INV-06: gateway ids only, never card data
  gateway_txn_id String?       @unique @db.VarChar(255)
  status         PaymentStatus @default(Succeeded)
  created_at     DateTime      @default(now()) @db.Timestamptz(3)
  created_by     String?       @db.Uuid
  updated_at     DateTime      @updatedAt @db.Timestamptz(3)
  updated_by     String?       @db.Uuid
  version        Int           @default(1)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  invoice   Invoice   @relation(fields: [invoice_id], references: [id], onDelete: Restrict)

  @@index([invoice_id])
  @@map("payments")
}

model Expense {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspace_id    String   @db.Uuid
  project_id      String   @db.Uuid
  date            DateTime @db.Date
  amount          BigInt
  currency        String   @db.Char(3)
  category        String?  @db.VarChar(80)
  description     String?
  is_billable     Boolean  @default(false)
  receipt_file_id String?  @db.Uuid
  invoice_line_id String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  created_by      String?  @db.Uuid
  updated_at      DateTime @updatedAt @db.Timestamptz(3)
  updated_by      String?  @db.Uuid
  version         Int      @default(1)

  workspace    Workspace    @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  project      Project      @relation(fields: [project_id], references: [id], onDelete: Restrict)
  receipt_file File?        @relation(fields: [receipt_file_id], references: [id], onDelete: SetNull)
  invoice_line InvoiceLine? @relation(fields: [invoice_line_id], references: [id], onDelete: SetNull)

  @@index([project_id, date])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Notifications and activity log
// ---------------------------------------------------------------------------

/// Exactly one recipient column is set (CHECK in migration).
model Notification {
  id           String              @id @default(uuid(7)) @db.Uuid
  workspace_id String              @db.Uuid
  user_id      String?             @db.Uuid
  contact_id   String?             @db.Uuid
  type         String              @db.VarChar(60)
  entity_type  String              @db.VarChar(40)
  entity_id    String              @db.Uuid
  /// Display data (title, actor name) captured when sent
  payload      Json?
  channel      NotificationChannel @default(InApp)
  sent_at      DateTime?           @db.Timestamptz(3)
  read_at      DateTime?           @db.Timestamptz(3)
  created_at   DateTime            @default(now()) @db.Timestamptz(3)
  created_by   String?             @db.Uuid
  updated_at   DateTime            @updatedAt @db.Timestamptz(3)
  updated_by   String?             @db.Uuid

  workspace Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  user      User?          @relation(fields: [user_id], references: [id], onDelete: Restrict)
  contact   ClientContact? @relation(fields: [contact_id], references: [id], onDelete: Restrict)

  @@index([user_id, read_at, created_at])
  @@index([contact_id, read_at, created_at])
  @@map("notifications")
}

/// Append-only (BR-ACT-01): a trigger rejects UPDATE and DELETE.
/// created_at is the event timestamp. updated_* exist only to keep the common
/// column set; they never change.
model ActivityLog {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspace_id String    @db.Uuid
  actor_type   ActorType
  /// User or ClientContact id; null for System
  actor_id     String?   @db.Uuid
  action       String    @db.VarChar(60)
  entity_type  String    @db.VarChar(40)
  /// Null when there is no record, e.g. a failed login for an unknown email
  entity_id    String?   @db.Uuid
  /// Scope for the per-project / per-client feeds (FR-ACT-01)
  project_id   String?   @db.Uuid
  client_id    String?   @db.Uuid
  before       Json?
  after        Json?
  ip           String?   @db.VarChar(45)
  user_agent   String?   @db.VarChar(512)
  request_id   String?   @db.VarChar(64)
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  created_by   String?   @db.Uuid
  updated_at   DateTime  @default(now()) @db.Timestamptz(3)
  updated_by   String?   @db.Uuid

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)

  @@index([workspace_id, created_at])
  @@index([entity_type, entity_id, created_at])
  @@index([project_id, created_at])
  @@index([client_id, created_at])
  @@index([actor_type, actor_id, created_at])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Authentication (Phase 1)
// ---------------------------------------------------------------------------

/// One signed-in device. The refresh token (a JWT) carries session id + jti; only
/// the SHA-256 of the current jti is stored. Rotated on every refresh; a reused
/// old jti revokes the session. Exactly one of user_id / contact_id (CHECK).
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  workspace_id     String    @db.Uuid
  user_id          String?   @db.Uuid
  contact_id       String?   @db.Uuid
  refresh_jti_hash String    @db.Char(64)
  /// Internal users only: refresh lifetime 30 days instead of 7 (FR-AUTH-10)
  remember_me      Boolean   @default(false)
  last_activity_at DateTime  @default(now()) @db.Timestamptz(3)
  expires_at       DateTime  @db.Timestamptz(3)
  revoked_at       DateTime? @db.Timestamptz(3)
  revoke_reason    String?   @db.VarChar(40)
  ip               String?   @db.VarChar(45)
  user_agent       String?   @db.VarChar(512)
  created_at       DateTime  @default(now()) @db.Timestamptz(3)
  created_by       String?   @db.Uuid
  updated_at       DateTime  @updatedAt @db.Timestamptz(3)
  updated_by       String?   @db.Uuid

  workspace Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  user      User?          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contact   ClientContact? @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at])
  @@index([contact_id, revoked_at])
  @@map("sessions")
}

/// Single-use emailed links: invitation (7 days), password reset (60 min),
/// email change (24 h). Only the SHA-256 of the token is stored.
model AuthToken {
  id           String           @id @default(uuid(7)) @db.Uuid
  workspace_id String           @db.Uuid
  purpose      AuthTokenPurpose
  token_hash   String           @unique @db.Char(64)
  user_id      String?          @db.Uuid
  contact_id   String?          @db.Uuid
  /// EmailChange only: the address being verified
  new_email    String?          @db.VarChar(254)
  expires_at   DateTime         @db.Timestamptz(3)
  used_at      DateTime?        @db.Timestamptz(3)
  revoked_at   DateTime?        @db.Timestamptz(3)
  created_at   DateTime         @default(now()) @db.Timestamptz(3)
  created_by   String?          @db.Uuid
  updated_at   DateTime         @updatedAt @db.Timestamptz(3)
  updated_by   String?          @db.Uuid

  workspace Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  user      User?          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contact   ClientContact? @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose])
  @@index([contact_id, purpose])
  @@map("auth_tokens")
}

/// Failed-login counter per email, for known and unknown emails alike
/// (FR-AUTH-11: 5 failures in 15 min → locked 15 min).
model LoginThrottle {
  id                String    @id @default(uuid(7)) @db.Uuid
  workspace_id      String    @db.Uuid
  email             String    @unique @db.VarChar(254)
  failed_count      Int       @default(0)
  window_started_at DateTime  @default(now()) @db.Timestamptz(3)
  locked_until      DateTime? @db.Timestamptz(3)
  created_at        DateTime  @default(now()) @db.Timestamptz(3)
  created_by        String?   @db.Uuid
  updated_at        DateTime  @updatedAt @db.Timestamptz(3)
  updated_by        String?   @db.Uuid

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)

  @@map("login_throttles")
}

// ---------------------------------------------------------------------------
// Task checklists and project templates (Phase 3)
// ---------------------------------------------------------------------------

/// FR-TSK-05: simple checklist inside a task; does not affect progress.
model TaskChecklistItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspace_id String   @db.Uuid
  task_id      String   @db.Uuid
  text         String   @db.VarChar(500)
  is_done      Boolean  @default(false)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  created_by   String?  @db.Uuid
  updated_at   DateTime @updatedAt @db.Timestamptz(3)
  updated_by   String?  @db.Uuid
  version      Int      @default(1)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  task      Task      @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id, sort_order])
  @@map("task_checklist_items")
}

/// FR-PRJ-02/03 (D-26): reusable project structure. Dates are day offsets from
/// the project start. Never stores assignees, comments, files or time.
model ProjectTemplate {
  id                String      @id @default(uuid(7)) @db.Uuid
  workspace_id      String      @db.Uuid
  name              String      @db.VarChar(150)
  name_normalized   String      @db.VarChar(150)
  description       String?
  billing_type      BillingType @default(Fixed)
  /// The project it was saved from (kept even if that project is deleted)
  source_project_id String?     @db.Uuid
  created_at        DateTime    @default(now()) @db.Timestamptz(3)
  created_by        String?     @db.Uuid
  updated_at        DateTime    @updatedAt @db.Timestamptz(3)
  updated_by        String?     @db.Uuid
  version           Int         @default(1)

  workspace  Workspace           @relation(fields: [workspace_id], references: [id], onDelete: Restrict)
  milestones TemplateMilestone[]
  tasks      TemplateTask[]
  members    TemplateMember[]
  projects   Project[]

  @@unique([workspace_id, name_normalized])
  @@map("project_templates")
}

model TemplateMilestone {
  id              String     @id @default(uuid(7)) @db.Uuid
  workspace_id    String     @db.Uuid
  template_id     String     @db.Uuid
  title           String     @db.VarChar(255)
  description     String?
  due_offset_days Int
  amount          BigInt?
  visibility      Visibility @default(Internal)
  sort_order      Int        @default(0)
  created_at      DateTime   @default(now()) @db.Timestamptz(3)
  created_by      String?    @db.Uuid
  updated_at      DateTime   @updatedAt @db.Timestamptz(3)
  updated_by      String?    @db.Uuid

  template ProjectTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  tasks    TemplateTask[]

  @@index([template_id])
  @@map("template_milestones")
}

model TemplateTask {
  id                    String       @id @default(uuid(7)) @db.Uuid
  workspace_id          String       @db.Uuid
  template_id           String       @db.Uuid
  template_milestone_id String?      @db.Uuid
  parent_id             String?      @db.Uuid
  title                 String       @db.VarChar(255)
  description           String?
  priority              TaskPriority @default(Normal)
  visibility            Visibility   @default(Internal)
  estimate_minutes      Int?
  is_billable           Boolean?
  labels                String[]     @default([])
  start_offset_days     Int?
  due_offset_days       Int?
  sort_order            Int          @default(0)
  /// Checklist texts, in order
  checklist             String[]     @default([])
  /// Template tasks this one depends on (finish-to-start, D-26)
  predecessor_ids       String[]     @default([]) @db.Uuid
  created_at            DateTime     @default(now()) @db.Timestamptz(3)
  created_by            String?      @db.Uuid
  updated_at            DateTime     @updatedAt @db.Timestamptz(3)
  updated_by            String?      @db.Uuid

  template  ProjectTemplate    @relation(fields: [template_id], references: [id], onDelete: Cascade)
  milestone TemplateMilestone? @relation(fields: [template_milestone_id], references: [id], onDelete: SetNull)
  parent    TemplateTask?      @relation("TemplateSubtasks", fields: [parent_id], references: [id], onDelete: Cascade)
  subtasks  TemplateTask[]     @relation("TemplateSubtasks")

  @@index([template_id])
  @@map("template_tasks")
}

/// Default members added when a project is created from the template.
model TemplateMember {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspace_id String   @db.Uuid
  template_id  String   @db.Uuid
  user_id      String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  created_by   String?  @db.Uuid
  updated_at   DateTime @updatedAt @db.Timestamptz(3)
  updated_by   String?  @db.Uuid

  template ProjectTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, user_id])
  @@map("template_members")
}
