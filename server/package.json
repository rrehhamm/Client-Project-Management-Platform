{
  "name": "@cpm/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../shared/src src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "storage:init": "node scripts/init-storage.js",
    "e2e:server": "node scripts/e2e-server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@cpm/shared": "0.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "node-cron": "4.6.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "vitest": "5.0.5"
  }
}
