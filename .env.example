# Copy to .env (npm run setup does this for you). Never commit .env.
# Values below are for LOCAL DEVELOPMENT ONLY.

# --- App ---------------------------------------------------------------
NODE_ENV=development
# Port the Express API listens on
API_PORT=4000
# Origin of the React app (used for CORS-free dev proxy, links in emails)
APP_URL=http://localhost:5173
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set to true (or a hop count) when running behind a reverse proxy, so req.ip is the client IP
TRUST_PROXY=false

# --- PostgreSQL (docker compose service "postgres") ---------------------
POSTGRES_USER=cpm
POSTGRES_PASSWORD=cpm_dev_password
POSTGRES_DB=cpm
POSTGRES_PORT=5432
# Used by the server and Prisma
DATABASE_URL=postgresql://cpm:cpm_dev_password@localhost:5432/cpm
# Used by the test suite. Must end in _test: the test setup wipes it.
TEST_DATABASE_URL=postgresql://cpm:cpm_dev_password@localhost:5432/cpm_test
# Used by the browser tests (Playwright). Must end in _e2e: each run wipes and reseeds it.
# Optional: defaults to DATABASE_URL with the database name cpm_e2e.
E2E_DATABASE_URL=postgresql://cpm:cpm_dev_password@localhost:5432/cpm_e2e

# --- S3-compatible storage (docker compose service "minio") -------------
MINIO_ROOT_USER=cpm_minio
MINIO_ROOT_PASSWORD=cpm_minio_dev_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cpm-files
S3_ACCESS_KEY=cpm_minio
S3_SECRET_KEY=cpm_minio_dev_secret
# FR-FILE-04: signed download URLs expire after 10 minutes
SIGNED_URL_TTL_SECONDS=600
# OD-07 defaults: 100 MB per file, 50 GB per workspace
FILE_MAX_BYTES=104857600
STORAGE_QUOTA_BYTES=53687091200
# Address browsers use for signed download links (production: https://files.<domain>). Empty = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

# --- Virus scanning (BR-FILE-02, D-30) -------------------------------------
# clamav | none. Start ClamAV locally with: docker compose --profile scan up -d
SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Development only: without a scanner, mark uploads clean so they can be downloaded.
# Without this, uploads stay "Scanning". Refused when NODE_ENV=production.
DEV_MARK_FILES_CLEAN=true

# --- Email (docker compose service "mailpit") ---------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexa <no-reply@nexa.test>"
MAILPIT_UI_PORT=8025

# --- Security -----------------------------------------------------------
# BR-AUTH-02: bcrypt cost (minimum 12)
BCRYPT_COST=12
# Signing secrets, at least 32 characters each and all different.
# `npm run setup` replaces these placeholders with random values in your .env.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
CSRF_SECRET=change-me-csrf-secret-at-least-32-characters
# Cookies carry the Secure flag. Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true
# NFR-SEC-06: requests per minute per IP on sign-in endpoints / per user on the API
AUTH_RATE_LIMIT_PER_MINUTE=20
API_RATE_LIMIT_PER_MINUTE=100

# --- Seed data (BRD 19.1) -----------------------------------------------
# Password given to every seeded account. Meets BR-AUTH-01.
SEED_PASSWORD=Nexa-dev-2026
