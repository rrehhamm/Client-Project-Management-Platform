# Caddy: automatic HTTPS (Let's Encrypt), HTTP → HTTPS redirect and HSTS (NFR-SEC-01),
# security headers (NFR-SEC-05), the client app and /api → API.
# FILES_ORIGIN is where signed download links point (S3_PUBLIC_ENDPOINT): the bundled
# MinIO behind this Caddy, or an external S3-compatible service (D-38).
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Previews and avatars load from the files origin; PDFs preview in a frame (FR-FILE-03)
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$FILES_ORIGIN}; frame-src {$FILES_ORIGIN}; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# STORAGE=bundled serves the files host for MinIO; STORAGE=external adds nothing.
import /etc/caddy/storage-{$STORAGE}.caddy
