# Production settings (D-29). Copy to the repository root as .env.production,
# fill every value, and keep the file out of git (it is ignored).
# Generate secrets with:  openssl rand -base64 48

# --- Domain ------------------------------------------------------------------
# DNS A/AAAA record pointing at this VM
APP_DOMAIN=app.example.com
# Let's Encrypt account email (certificate expiry notices)
ACME_EMAIL=ops@example.com

# --- Database ---------------------------------------------------------------
POSTGRES_USER=cpm
POSTGRES_DB=cpm
POSTGRES_PASSWORD=

# --- File storage (D-38) -------------------------------------------------------
# Option A — bundled: MinIO runs on this VM. Needs a second DNS record (FILES_DOMAIN).
STORAGE=bundled
COMPOSE_PROFILES=bundled-storage
FILES_DOMAIN=files.example.com
MINIO_ROOT_USER=cpm-storage
MINIO_ROOT_PASSWORD=
S3_REGION=us-east-1
S3_BUCKET=cpm-files
#
# Option B — external: any S3-compatible provider (for example Cloudflare R2, Backblaze B2,
# AWS S3). Comment out Option A's STORAGE, COMPOSE_PROFILES, FILES_DOMAIN and MINIO_* lines,
# create a private bucket and an access key limited to it, then set:
# STORAGE=external
# COMPOSE_PROFILES=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# FILES_ORIGIN=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=cpm-files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=600
FILE_MAX_BYTES=104857600
STORAGE_QUOTA_BYTES=53687091200

# --- Email (your SMTP provider) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Agency name <no-reply@example.com>"

# --- Security -----------------------------------------------------------------
# Three different values, each at least 32 characters
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
BCRYPT_COST=12
# NFR-SEC-06
AUTH_RATE_LIMIT_PER_MINUTE=20
API_RATE_LIMIT_PER_MINUTE=100
LOG_LEVEL=info
